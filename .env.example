# Public production site URL, used for absolute canonicals, hreflang, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Google Search Console verification token for the root metadata verification tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Google Analytics 4 Measurement ID. Leave empty until Analytics is ready to activate.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
